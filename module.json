      "label": "Critical & Fumble Results",
      "type": "JournalEntry",
      "path": "packs/critical-fumble-results"
    },
    {
      "name": "critical-fumble-sounds",
      "label": "Critical & Fumble Sounds",
      "type": "Playlist",
      "path": "packs/critical-fumble-sounds"
    }
  ],
  "packFolders": [
    {
      "name": "ZFT Critical Fumbles",
      "sorting": "m",
