{
  "id": "zft-critical-fumbles",
  "title": "ZFT Critical Fumbles",
  "description": "Detects and classifies single-result d20 rolls for configurable critical and fumble handling, seeds module-owned RollTable/Journal content, renders Journal-driven outcome chat cards, supports reminder Active Effects and sounds, tracks per-user totals, and provides a persistent GM-managed Criticals & Fumbles sidebar with collapsible history, individual/all clearing, and token pinging.",
  "version": "1.3.0",
  "authors": [
    {
      "name": "Luvac Zantor"
    }
  ],
  "compatibility": {
    "minimum": "13",
    "verified": "14"
  },
  "relationships": {
    "systems": [
      {
        "id": "dnd5e",
        "type": "system",
        "compatibility": {}
      }
    ]
  },
  "esmodules": [
    "scripts/main.mjs",
    "scripts/reminder-effects.mjs"
  ],
  "styles": [
    "styles/zft-critical-fumbles.css",
    "styles/zft-critical-fumbles-sidebar.css"
  ],
  "packs": [
    {
      "name": "critical-fumble-tables",
      "label": "Critical & Fumble Tables",
      "type": "RollTable",
      "path": "packs/critical-fumble-tables"
    },
    {
